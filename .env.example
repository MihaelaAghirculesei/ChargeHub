# Open Charge Map API key — register at https://openchargemap.org/site/develop/api
# Never commit the real value: copy this file to .env and paste the key there.
NUXT_OCM_API_KEY=

# Key to seal the session cookie (mock login, Day 16) — at least 32 random
# characters. Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Natural-language station search (ADR-0007). Optional: without this key the
# app still works, only that feature responds with 503.
#
# Before deploying with a real key, secure the spend first — the in-app
# limits (rate-limiter.ts: per-IP + global daily cap, plus the response
# cache) only reduce the blast radius, they are not a hard ceiling. The only
# real ceiling is on the provider side:
#   1. Create a dedicated Workspace on console.anthropic.com and generate the
#      key inside it — isolates the blast radius from the rest of the account.
#   2. Set a monthly spend limit on the Workspace (Settings -> Limits). It is
#      the only limit that holds even with a bug in the code or an attack
#      spread across many IPs.
#   3. Enable cost email alerts at a threshold below that limit.
#   4. Key rotation: create a new one in the Workspace -> update this env on
#      Vercel -> redeploy -> revoke the old one. The Console also has a
#      one-click disable if you spot anomalous usage.
NUXT_ANTHROPIC_API_KEY=
