# Open Charge Map API key — registrati su https://openchargemap.org/site/develop/api
# Non committare mai il valore reale: copia questo file in .env e incolla la chiave lì.
NUXT_OCM_API_KEY=

# Chiave per sigillare il cookie di sessione (login mock, Giorno 16) — almeno
# 32 caratteri casuali. Genera la tua, es.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=
