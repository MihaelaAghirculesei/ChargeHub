    "nuxt": "^4.5.2",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.0",
    "vuetify": "^3.13.2",
    "vuetify-nuxt-module": "1.0.0-rc.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
